# Ghostty Configuration - Migrated from Alacritty
# Font settings
font-family = CaskaydiaMono Nerd Font
font-size = 18
cursor-style = block
cursor-style-blink = false

# Window settings
window-padding-x = 14
window-padding-y = 14
window-decoration = false
macos-titlebar-style = tabs
window-save-state = never
quit-after-last-window-closed = true
background-opacity = 1
background-opacity-cells = false
background-blur-radius = 20
macos-non-native-fullscreen = true

# Environment
term = xterm-256color

# Left Option acts as Alt so terminal keybinds (Alt+Up/Down etc.) work.
# Right Option still types macOS Unicode characters (é, ü, …).
macos-option-as-alt = left

# Follow macOS Appearance (including its automatic schedule).
theme = dark:TokyoNight Moon,light:TokyoNight Day

# Key bindings
keybind = f11=toggle_fullscreen
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
keybind = super+v=paste_from_clipboard
# Free Ctrl+Tab for TUI apps (OpenCode session tabs).
# Ghostty keeps Cmd+Shift+[ / ] and Cmd+1..9 for its own tabs.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
# Note: Shift+Return with escape sequence needs manual shell binding
